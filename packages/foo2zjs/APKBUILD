# Contributor: hp1020-alpine-rpi contributors <baiyunquan@users.noreply.github.com>
# Maintainer: hp1020-alpine-rpi contributors <baiyunquan@users.noreply.github.com>
pkgname=foo2zjs
pkgver=20260725
pkgrel=0
pkgdesc="OpenPrinting foo2zjs printer driver"
url="https://github.com/OpenPrinting/foo2zjs"
arch="armv7"
license="GPL-2.0-or-later"
depends=""
makedepends="cups-dev gzip"
subpackages="$pkgname-cups:cups:noarch $pkgname-hp1020:hp1020:noarch"
options="!check"
_commit=f8500e3b1de02b5d88330ebd4d2ea079e2bebbfd
source="$pkgname-$_commit.tar.gz::https://github.com/OpenPrinting/foo2zjs/archive/$_commit.tar.gz
	hp1020-firmware-loader
	hp1020-firstboot
	hp1020-openrc
	hp1020-udev.rules
	"
builddir="$srcdir/$pkgname-$_commit"

build() {
	make jbig.o jbig_ar.o
	make LIBJBG="jbig.o jbig_ar.o" \
		foo2zjs arm2hpdl foo2zjs-wrapper foo2zjs-pstops
}

package() {
	install -Dm755 foo2zjs "$pkgdir/usr/bin/foo2zjs"
	install -Dm755 arm2hpdl "$pkgdir/usr/bin/arm2hpdl"
	install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}

cups() {
	pkgdesc="CUPS filter and HP LaserJet 1020 PPD for foo2zjs"
	depends="$pkgname=$pkgver-r$pkgrel ghostscript cups-filters"

	install -Dm755 "$builddir/foo2zjs-wrapper" \
		"$subpkgdir/usr/bin/foo2zjs-wrapper"
	install -Dm755 "$builddir/foo2zjs-pstops" \
		"$subpkgdir/usr/bin/foo2zjs-pstops"
	install -d "$subpkgdir/usr/share/cups/model"
	gzip -9c "$builddir/PPD/HP-LaserJet_1020.ppd" \
		> "$subpkgdir/usr/share/cups/model/HP-LaserJet_1020.ppd.gz"
}

hp1020() {
	pkgdesc="HP LaserJet 1020 firmware hotplug integration"
	depends="$pkgname-cups=$pkgver-r$pkgrel cups usbutils"

	install -Dm755 "$srcdir/hp1020-firmware-loader" \
		"$subpkgdir/usr/libexec/hp1020-firmware-loader"
	install -Dm755 "$srcdir/hp1020-firstboot" \
		"$subpkgdir/usr/libexec/hp1020-firstboot"
	install -Dm755 "$srcdir/hp1020-openrc" \
		"$subpkgdir/etc/init.d/hp1020"
	install -Dm644 "$srcdir/hp1020-udev.rules" \
		"$subpkgdir/etc/udev/rules.d/70-hp1020.rules"
	install -d "$subpkgdir/usr/share/foo2zjs/firmware"
}

