# shellcheck shell=sh
ARCH=armv7
ALPINE_BRANCH=v3.23
OLDKERNEL=
DEV=eudev
DEFAULT_HOSTNAME=hp1020
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_DROPBEAR_ENABLED=true
DEFAULT_ROOT_PASSWORD=1234
ADDITIONAL_KERNEL_MODULES="usblp rtw88_8822cu 8821cu"
RTL8811CU_BUILD_JOBS=2
OVERLAY=true
LIB_LOG=true
SIZE_BOOT=32M
SIZE_ROOT_FS=0
SIZE_ROOT_PART=256M
SIZE_DATA=64M
ENABLE_AVAHI=true
ENABLE_SSH=true
RUN_QEMU_SMOKE_TEST=false
IMAGE_VERSION=0.1.0
