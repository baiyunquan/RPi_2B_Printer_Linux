# shellcheck shell=sh
ARCH=armv7
ALPINE_BRANCH=v3.23
DEV=eudev
DEFAULT_HOSTNAME=hp1020
DEFAULT_TIMEZONE=Asia/Shanghai
DEFAULT_DROPBEAR_ENABLED=false
DEFAULT_ROOT_PASSWORD=build-time-password-is-locked
ADDITIONAL_KERNEL_MODULES=usblp
OVERLAY=true
LIB_LOG=true
SIZE_BOOT=100M
SIZE_ROOT_FS=0
SIZE_ROOT_PART=500M
SIZE_DATA=128M
ENABLE_AVAHI=true
ENABLE_SSH=false
RUN_QEMU_SMOKE_TEST=false
IMAGE_VERSION=0.1.0
